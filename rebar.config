{erl_opts, [debug_info]}.

{deps, [
    %grisp_tools,
    {grisp_tools, {git, "https://github.com/grisp/grisp_tools.git",
                   {branch, "sylane/rust-support"}}},
    grid,
    erlware_commons,
    getopt
]}.

{project_plugins, [
    rebar3_ex_doc
]}.

%% Rebar's embedded APIs have no debug information in a normal installation.
%% The dialyzer profile below checks external calls with full type information.
{dialyzer, [
    {warnings, [no_unknown]},
    {plt_extra_apps, [erlware_commons, getopt]}
]}.

{profiles, [
    {test, [{deps, [
        {rebar3_cargo, {git, "https://github.com/grisp/rebar3_cargo.git",
                        {branch, "cross_build_support_0_1_1"}}}
    ]}]},
    {dialyzer, [
        {deps, [
            {rebar, {git_subdir, "https://github.com/erlang/rebar3.git",
                     {tag, "3.28.0"}, "apps/rebar"}},
            {rebar3_cargo, {git, "https://github.com/grisp/rebar3_cargo.git",
                            {branch, "cross_build_support_0_1_1"}}}
        ]},
        {overrides, [
            %% Dependencies use prod; retain Rebar's type information for analysis.
            {override, rebar, [{profiles, [{prod, [
                {erl_opts, [debug_info, nowarn_deprecated_catch]}
            ]}]}]},
            {add, relx, [{erl_opts, [nowarn_deprecated_catch]}]}
        ]},
        {dialyzer, [
            {warnings, [unknown]},
            {plt_apps, all_deps},
            {plt_extra_apps, [rebar, rebar3_cargo, cargo, providers, relx,
                              erlware_commons, getopt]}
        ]}
    ]}
]}.

{hex, [{doc, ex_doc}]}.
{ex_doc, [
    {extras, [
          {"CHANGELOG.md", #{title => "Changelog"}},
          {"README.md", #{title => "Overview"}},
          {"LICENSE", #{title => "License"}}
    ]},
    {main, "README.md"},
    {homepage_url, "https://github.com/grisp/rebar3_grisp"},
    {source_url, "https://github.com/grisp/rebar3_grisp"}
]}.
