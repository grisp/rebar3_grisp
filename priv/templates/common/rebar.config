{deps, [
    grisp{{^grisp_io}}
{{/grisp_io}}{{#grisp_io}},
    certifi,
    grisp_cryptoauth,
    grisp_updater_grisp2,
    grisp_connect{{/grisp_io}}{{^epmd}}
{{/epmd}}{{#epmd}},
    {epmd, {git, "https://github.com/erlang/epmd", {ref, "4d1a59"}}}
    {{/epmd}}
]}.

{erl_opts, [debug_info]}.

{project_plugins, [
    rebar3_grisp{{#grisp_io}},
    rebar3_grisp_io{{/grisp_io}}
]}.
{{#rust}}

{plugins, [
    {rebar3_cargo, {git, "https://github.com/grisp/rebar3_cargo.git",
                    {branch, "cross_build_support_0_1_1"}}}
]}.
{cargo_opts, [{src_dir, "native"}]}.
{provider_hooks, [
    {pre, [{compile, {cargo, build}}]},
    {post, [{clean, {cargo, clean}}]}
]}.
{{/rust}}

{grisp, [
    {{#native}}
    {build, [{toolchain, [{docker, "grisp/grisp2-rtems-toolchain:latest"}]}]},
    {{/native}}
    {otp, [
        {version, "{{{otp_version}}}"},
        {jit, {{{jit}}}}
    ]},
    {deploy, [
        {destination, {{{dest_literal}}}}
    ]}
]}.

{shell, [{apps, []}]}.

{relx, [
    {release, {{{{name}}}, "0.1.0"}, [
        {{#epmd}}
        {epmd, none},
        {{/epmd}}
        {{#grisp_io}}
        {grisp_updater_grisp2, load},
        sasl,
        {{/grisp_io}}
        {{{name}}}
    ]}
]}.
